# =============================================================================
# Auto Platform — environment example (no real secrets)
# Copy to apps/web/.env.local and/or repo-root .env.local
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Tenant subdomains: acme.localhost:3000 / beta.localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# --- Supabase (public — Auth cookies / anon client; never service_role on user paths) ---
# NEXT_PUBLIC_* values are exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# --- Database (server-only — Drizzle) ---
# Use the Supabase Postgres connection string (Session pooler recommended for app).
# Prefer a role that does NOT have BYPASSRLS for runtime queries.
# Never put service_role into user request paths.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Optional elevated URL used only for migrations (table owner / postgres).
# DATABASE_URL_MIGRATIONS=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- Supabase server (rare; never on user request paths) ---
# Server-only. Required for signed media URLs / gallery on deployed demo.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Storage (Etapa 4+) ---
NEXT_PUBLIC_MEDIA_BUCKET=vehicle-media

# --- Public leads (Etapa 10) ---
# noop (default) | log — no live email provider in v1. Never set Resend keys here for Hobby demo.
LEAD_EMAIL_PROVIDER=noop
# Server-only hash pepper for IP rate-limit keys (recommended on any public URL).
# LEAD_RATE_LIMIT_SECRET=

# --- Vercel Hobby demo only (Etapa 12) — server-only; never for real production ---
# Active only when VERCEL=1 + ALL gates pass (see docs/stages/12-hardening-deploy.md).
# Do NOT use on custom domains / wildcard multi-tenant production.
# VERCEL_DEMO_ONLY=
# VERCEL_DEMO_TENANT_SLUG=
# VERCEL_DEMO_DISABLE_PUBLIC_LEADS=

# --- Dev seed (Etapa 2 validation) ---
# Create two users in Supabase Auth → Authentication → Users → Add user,
# then paste their real User UIDs here (must exist in auth.users).
SEED_PROFILE_A_ID=00000000-0000-4000-8000-000000000001
SEED_PROFILE_B_ID=00000000-0000-4000-8000-000000000002
