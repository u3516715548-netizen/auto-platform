{
  "name": "@auto-platform/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    }
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "node ./scripts/migrate.mjs",
    "studio": "drizzle-kit studio",
    "seed": "tsx src/seed/dev-tenants.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@auto-platform/types": "workspace:*",
    "drizzle-orm": "^0.41.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@auto-platform/config": "workspace:*",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^5.0.3"
  }
}
